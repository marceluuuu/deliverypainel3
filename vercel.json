{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/custom_checkout.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/custom_checkout",
      "destination": "/api/index.js"
    },
    {
      "source": "/pagamento_pix.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/pagamento_pix",
      "destination": "/api/index.js"
    },
    {
      "source": "/escolha_entrega.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/escolha_entrega",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin-login",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin-login.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/index.html/admin.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/index.html/admin-login.html",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.json,css/**,images/**,js/**,produtos/**,uploads/**}"
    }
  }
}
